# Copy to .env (gitignored). Placeholders only — never commit secrets.

# --- Control plane (Next.js / Vercel) ---
# Pooled Neon URL for the app (Prisma + @prisma/adapter-neon)
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# Optional direct (non-pooler) URL for Prisma CLI (db pull / migrate)
# DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-high-entropy-secret
REFERRAL_CODE=your-invite-code

# UI chat → Olla gateway (must match gateway CHAT_SERVICE_KEY)
INFERENCE_GATEWAY_URL=https://api.dgxspark.dev
INFERENCE_GATEWAY_API_KEY=dgx_chat_replace_me
INFERENCE_GATEWAY_ADMIN_KEY=dgx_admin_replace_me
