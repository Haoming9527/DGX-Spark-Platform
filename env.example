# Copy to .env (gitignored). Placeholders only — never commit secrets.

# --- Control plane (Next.js / Vercel) ---
# Pooled Neon URL for the app (Prisma + @prisma/adapter-neon)
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# Optional direct (non-pooler) URL for Prisma CLI (db pull / migrate)
# DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-high-entropy-secret
REFERRAL_CODE=your-invite-code

# UI chat → Olla gateway (must match gateway CHAT_SERVICE_KEY)
INFERENCE_GATEWAY_URL=https://api.dgxspark.dev
INFERENCE_GATEWAY_API_KEY=dgx_chat_replace_me
INFERENCE_GATEWAY_ADMIN_KEY=dgx_admin_replace_me

# Admin → Infrastructure (server-side only; never use NEXT_PUBLIC_ for the key).
# Use a URL reachable from the Next.js server. Vercel cannot reach a Pi LAN IP.
INFRA_GATEWAY_URL=https://api.dgxspark.dev
# Must match INFRA_READ_KEY in gateway/.env; separate from the AI service keys.
INFRA_GATEWAY_READ_KEY=replace-with-a-random-infra-read-key
# Spark actions for active admins and operators; server-only.
# Must match gateway INFRA_CONTROL_KEY and differ from the read/AI keys.
INFRA_GATEWAY_CONTROL_KEY=replace-with-a-distinct-random-infra-control-key
