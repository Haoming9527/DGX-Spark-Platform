# Copy to .env; keep real secrets out of Git.

# Database
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-high-entropy-secret
REFERRAL_CODE=your-invite-code

# Leave blank on Vercel; self-hosting requires a proxy that overwrites this header and blocks direct access.
TRUSTED_CLIENT_IP_HEADER=

# AI gateway (keys must match the gateway).
INFERENCE_GATEWAY_URL=https://api.dgxspark.dev
INFERENCE_GATEWAY_API_KEY=dgx_chat_replace_me
INFERENCE_GATEWAY_ADMIN_KEY=dgx_admin_replace_me

# Infrastructure (server-only keys; match gateway read/control keys).
INFRA_GATEWAY_URL=https://api.dgxspark.dev
INFRA_GATEWAY_READ_KEY=replace-with-a-random-infra-read-key
INFRA_GATEWAY_CONTROL_KEY=replace-with-a-distinct-random-infra-control-key
