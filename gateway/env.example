# Copy to gateway/.env (gitignored) before `docker compose up --build`
#
# First inference node (Singapore DGX Spark via Cloudflare/Caddy)

SG_API_ENDPOINT=https://sg.dgxspark.dev
SG_API_KEY=replace-with-node-x-api-key

# Host ports
OLLA_PORT=40114
API_PORT=8080
# Next.js UI chat key 
CHAT_SERVICE_KEY=dgx_chat_replace_me

# Neon — required for user dgx_sk_* API keys (optional if only testing chat key)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional — default is /config/system-prompt.md (mounted from ./system-prompt.md)
# SYSTEM_PROMPT_FILE=/config/system-prompt.md

