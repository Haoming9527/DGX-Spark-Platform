#!/bin/sh
# Validate arguments independently of the SSH wrapper.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C
umask 077
exec </dev/null

[ "$(id -u)" -eq 0 ] || { printf '%s\n' 'Root is required.' >&2; exit 77; }
case "${1:-}" in
    status) [ "$#" -eq 1 ] || exit 64 ;;
    shutdown)
        [ "$#" -eq 2 ] || exit 64
        [ "${#2}" -eq 36 ] || exit 64
        printf '%s\n' "$2" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || exit 64
        ;;
    *) exit 64 ;;
esac

boot_id=$(cat /proc/sys/kernel/random/boot_id)
printf '%s\n' "$boot_id" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$' || exit 70
state=$(/usr/bin/systemctl is-system-running 2>/dev/null) || :
case "$state" in
    initializing|starting|running|degraded|maintenance|stopping|offline|unknown) ;;
    *) state=unknown ;;
esac

if [ "$1" = status ]; then
    uptime=$(awk '{print $1}' /proc/uptime)
    printf '%s\n' "$uptime" | grep -Eq '^[0-9]+([.][0-9]+)?$' || exit 70
    maintenance=false
    if [ -e /var/lib/spark-power/maintenance.lock ] || [ -L /var/lib/spark-power/maintenance.lock ]; then
        maintenance=true
    fi
    printf '{"protocol_version":2,"boot_id":"%s","state":"%s","uptime_seconds":%s,"maintenance_locked":%s}\n' "$boot_id" "$state" "$uptime" "$maintenance"
    exit 0
fi

[ "$2" = "$boot_id" ] || { printf '%s\n' 'Shutdown refused: Spark rebooted since the status check.' >&2; exit 75; }
case "$state" in
    running|degraded) ;;
    *) printf 'Shutdown refused while system state is %s.\n' "$state" >&2; exit 75 ;;
esac

if [ -e /var/lib/spark-power/maintenance.lock ] || [ -L /var/lib/spark-power/maintenance.lock ]; then
    printf '%s\n' 'Shutdown refused: Spark maintenance lock is active.' >&2
    exit 75
fi
# Include root-owned inhibitors that older logind versions may skip.
blocked=$(/usr/bin/busctl --system --timeout=3 get-property org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager BlockInhibited) || exit 75
case "$blocked" in
    's "'*'"') ;;
    *) printf '%s\n' 'Shutdown refused: could not read shutdown inhibitors.' >&2; exit 75 ;;
esac
blocked=${blocked#s \"}
blocked=${blocked%\"}
case ":$blocked:" in
    *:shutdown:*) printf '%s\n' 'Shutdown refused: active block inhibitor.' >&2; exit 75 ;;
esac

# Direct logind calls avoid blocking on our own SSH session.
# Flag 1 (SD_LOGIND_ROOT_CHECK_INHIBITORS) preserves inhibitor protection.
/usr/bin/busctl --system --timeout=3 --allow-interactive-authorization=no call org.freedesktop.login1 /org/freedesktop/login1 org.freedesktop.login1.Manager PowerOffWithFlags t 1 >/dev/null
# Acknowledges acceptance, not completed shutdown.
printf '{"protocol_version":2,"accepted":true,"boot_id":"%s"}\n' "$boot_id"
