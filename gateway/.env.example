# Copy to gateway/.env. This file is safe to commit; use real secrets only in .env.
# The Go binary reads process environment; Docker Compose loads .env for you.

# Listener. Compose binds API_PORT to 127.0.0.1 on the Pi.
API_PORT=50080
# Direct Go execution only; the Compose container listens on :8080.
API_LISTEN=:8080

# Existing AI gateway settings. Compose sets the internal Olla URL automatically.
# OLLA_URL is only needed for native Go execution with a non-default address.
# OLLA_URL=http://127.0.0.1:40114
OLLA_PORT=40114
SG_API_ENDPOINT=https://sg.dgxspark.dev
SG_API_KEY=replace-with-node-x-api-key
CHAT_SERVICE_KEY=dgx_chat_replace_me
ADMIN_SERVICE_KEY=dgx_admin_replace_me
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Docker mounts gateway/system-prompt.md here. For native runs use its local path.
SYSTEM_PROMPT_FILE=/config/system-prompt.md

# Read-only Athom meter for raspberry-pi-5.
# Use a distinct random secret; never reuse either AI key or the MQTT password.
INFRA_READ_KEY=replace-with-a-random-infra-read-key
MQTT_BROKER_URL=tcp://192.168.1.119:1883
MQTT_USERNAME=tasmota
MQTT_PASSWORD=replace-with-mqtt-password
# Name of the Pi gateway's connection to Mosquitto.
MQTT_CLIENT_ID=dgx-gateway-pi-power
# Assumes standard Tasmota FullTopic: %prefix%/%topic%/
TASMOTA_TOPIC=pi_power

# DGX Spark Singapore: shares the MQTT broker above, controls only this plug.
# Must differ from INFRA_READ_KEY, AI keys and MQTT password. Match the frontend
# INFRA_GATEWAY_CONTROL_KEY. Empty or incomplete Spark settings block its actions.
INFRA_CONTROL_KEY=replace-with-a-distinct-random-infra-control-key
DGX_SPARK_TASMOTA_TOPIC=dgx_spark_sg_power
# Set the Spark's reserved LAN IP and SSH port, e.g. 192.168.1.50:22.
DGX_SPARK_SSH_ADDR=spark-2c12.local
DGX_SPARK_SSH_USER=spark-power
# Container paths. Compose mounts gateway/secrets read-only; see docs/spark-power.md.
DGX_SPARK_SSH_KEY_FILE=/run/secrets/spark_power_ssh_key
DGX_SPARK_SSH_KNOWN_HOSTS_FILE=/run/secrets/spark_known_hosts
# Required for shutdown only. Calibrate fully-off watts before setting this value;
# do not guess a threshold. Leave empty until the attended calibration is complete.
DGX_SPARK_OFF_MAX_WATTS=
